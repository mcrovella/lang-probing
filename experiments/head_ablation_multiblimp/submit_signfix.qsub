#!/bin/bash -l

# Phase 3.2 (overnight): head-ablation MultiBLiMP diagnostic under the
# corrected sign convention + new top-10-POS / top-10-NEG / matched-control
# selection. Reads sign-migrated GCM IE from outputs/gcm_translation. Writes to
# a NEW output dir so the old top-20-split results are preserved for comparison.
# Only 4 conditions per lang (baseline, pos10, neg10, ctrl) -> fast.

#$ -N habl_signfix
#$ -t 1-8
#$ -l h_rt=0:50:00
#$ -l gpus=1
#$ -l gpu_type=A100
#$ -l gpu_c=8.0
#$ -l gpu_memory=64G

#$ -m ea
#$ -j y
#$ -o /projectnb/mcnet/jbrin/lang-probing/experiments/head_ablation_multiblimp/run/$JOB_NAME.$JOB_ID.$TASK_ID.out
#$ -V

set -e

module load miniconda
conda activate probes
export HF_HOME="/projectnb/mcnet/jbrin/.cache/huggingface"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

LANGS=(_ ara eng deu fra heb hin spa tur)
LANG=${LANGS[$SGE_TASK_ID]}

echo "=== signfix task ${SGE_TASK_ID}: lang=${LANG} (host=$HOSTNAME) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

cd /projectnb/mcnet/jbrin/lang-probing

python experiments/head_ablation_multiblimp/run.py \
    --lang_key "$LANG" \
    --max_pairs 400 \
    --mode full \
    --output_dir /projectnb/mcnet/jbrin/lang-probing/outputs/head_ablation_multiblimp_signfix
