#!/bin/bash -l

# v2 rerun for languages still missing matched POS/NEG controls.
# English already completed with 53 conditions in job 5462835.2, so this array
# avoids overwriting that completed output.

#$ -N habl_v2_missing
#$ -t 1-7
#$ -l h_rt=1:30:00
#$ -l gpus=1
#$ -l gpu_type=A100
#$ -l gpu_c=8.0
#$ -l gpu_memory=64G

#$ -m ea
#$ -j y
#$ -o /projectnb/mcnet/jbrin/lang-probing/experiments/head_ablation_multiblimp/run/$JOB_NAME.$JOB_ID.$TASK_ID.out
#$ -V

set -e

module load miniconda
conda activate probes
export HF_HOME="/projectnb/mcnet/jbrin/.cache/huggingface"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

LANGS=(_ ara deu fra heb hin spa tur)
LANG=${LANGS[$SGE_TASK_ID]}

echo "=== V2 missing task ${SGE_TASK_ID}: lang=${LANG} (host=$HOSTNAME) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

cd /projectnb/mcnet/jbrin/lang-probing

python experiments/head_ablation_multiblimp/run.py \
    --lang_key "$LANG" \
    --top_k 20 \
    --top_k_collective 5 \
    --max_pairs 400 \
    --n_ctrl_seeds 5 \
    --mode full
