#!/bin/bash -l

# Phase 1d (overnight): MultiBLiMP per-item logprob margins (correct - wrong),
# per-phenomenon, over the 18-language MultiBLiMP∩BLEU intersection. Forward
# only -> fast. Task 1 = Llama, Task 2 = Aya. Pin A100 (run_per has no sm_120
# guard, so avoid Blackwell).

#$ -N mblimp_margins
#$ -t 1-2
#$ -l h_rt=1:30:00
#$ -l gpus=1
#$ -l gpu_type=L40S
#$ -l gpu_c=8.9

#$ -m ea
#$ -j y
#$ -o /projectnb/mcnet/jbrin/lang-probing/experiments/perplexity_bleu_linear/run/$JOB_NAME.$JOB_ID.$TASK_ID.out
#$ -V

set -e

module load miniconda
conda activate probes
export HF_HOME="/projectnb/mcnet/jbrin/.cache/huggingface"

MODELS=(_ "meta-llama/Llama-3.1-8B" "CohereForAI/aya-23-8B")
MODEL_ID=${MODELS[$SGE_TASK_ID]}

echo "=== margins task ${SGE_TASK_ID}: ${MODEL_ID} (host=$HOSTNAME) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

cd /projectnb/mcnet/jbrin/lang-probing

python experiments/perplexity_bleu_linear/run_per.py \
    --margins_multilang \
    --dataset jumelet/multiblimp \
    --model_id "$MODEL_ID" \
    --split train \
    --batch_size 64 \
    --max_length 2048 \
    --device cuda \
    --output_dir /projectnb/mcnet/jbrin/lang-probing/outputs/perplexity_bleu_linear/multiblimp_margins
