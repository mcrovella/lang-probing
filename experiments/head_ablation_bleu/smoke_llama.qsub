#!/bin/bash -l

# Phase 3.3 smoke: Llama BLEU head-ablation on 2 source dirs into Spanish,
# 5% FLORES (~50 sents), batched. Validates the persistent o_proj generation
# hook + extract_translation + BLEU on a real model before the full sweep.

#$ -N bleu_abl_smoke
#$ -l h_rt=0:45:00
#$ -l gpus=1
#$ -l gpu_type=L40S
#$ -l gpu_c=8.9

#$ -j y
#$ -o /projectnb/mcnet/jbrin/lang-probing/experiments/head_ablation_bleu/run/$JOB_NAME.$JOB_ID.out
#$ -V

set -e
module load miniconda
conda activate probes
export HF_HOME="/projectnb/mcnet/jbrin/.cache/huggingface"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

echo "=== BLEU ablation smoke (host=$HOSTNAME) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
cd /projectnb/mcnet/jbrin/lang-probing

python -m experiments.head_ablation_bleu.run \
    --target_lang spa \
    --source_langs deu fra \
    --split_pct 5 \
    --batch_size 16 \
    --gcm_dir /projectnb/mcnet/jbrin/lang-probing/outputs/gcm_translation \
    --output_dir /projectnb/mcnet/jbrin/lang-probing/outputs/head_ablation_bleu_smoke
